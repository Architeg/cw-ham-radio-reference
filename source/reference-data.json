  "q_signals": [
    [
      "QRA",
      "What is the name of your station?",
      "The station name is ...",
      "For an operator’s personal name, NAME is usually clearer."
    ],
    [
      "QRB",
      "How far apart are our stations?",
      "Our approximate distance is ...",
      "Give a unit, such as KM."
    ],
    [
      "QRG",
      "Will you tell me my exact frequency?",
      "Your exact frequency is ...",
      "QRG 14060 KHZ"
    ],
    [
      "QRH",
      "Does my frequency vary?",
      "Your frequency varies.",
      "A drift report; describe what you hear."
    ],
    [
      "QRI",
      "How is the tone of my transmission?",
      "Tone: 1 good, 2 variable, 3 bad.",
      "This formal scale is not T1-T9 in RST."
    ],
    [
      "QRK",
      "How intelligible is my signal?",
      "Intelligibility is ... on a 1-5 scale.",
      "Most casual contacts use RST instead."
    ],
    [
      "QRL",
      "Are you busy?",
      "I am busy; please do not interfere.",
      "QRL? is the usual check before occupying a frequency."
    ],
    [
      "QRM",
      "Is my transmission being interfered with?",
      "Your transmission is being interfered with.",
      "In ordinary ham use, SRI QRM usually describes interference at my receiver."
    ],
    [
      "QRN",
      "Are you troubled by static?",
      "I am troubled by static.",
      "Commonly used for atmospheric noise; describe local electrical noise more specifically."
    ],
    [
      "QRO",
      "Shall I increase transmitter power?",
      "Increase transmitter power.",
      "HR QRO is a separate conversational use meaning higher-power operation."
    ],
    [
      "QRP",
      "Shall I decrease transmitter power?",
      "Decrease transmitter power.",
      "HR QRP means low-power operation; give watts when the value matters."
    ],
    [
      "QRQ",
      "Shall I send faster?",
      "Send faster.",
      "PSE QRQ"
    ],
    [
      "QRS",
      "Shall I send more slowly?",
      "Send more slowly.",
      "PSE QRS 10 WPM"
    ],
    [
      "QRT",
      "Shall I stop sending?",
      "Stop sending.",
      "QRT NW is commonly used to say I am closing down now."
    ],
    [
      "QRU",
      "Have you anything for me?",
      "I have nothing for you.",
      "Without the question mark, this is a negative answer."
    ],
    [
      "QRV",
      "Are you ready?",
      "I am ready.",
      "QRV AT 1500 UTC"
    ],
    [
      "QRW",
      "Shall I tell another station you are calling?",
      "Please tell that station I am calling.",
      "Name the station and frequency as needed."
    ],
    [
      "QRX",
      "When will you call again?",
      "I will call again at the stated time and frequency.",
      "QRX 1 MIN is commonly used as a request to wait."
    ],
    [
      "QRY",
      "What is my turn?",
      "Your turn is number ...",
      "Relates to a communication queue; uncommon in a casual contact."
    ],
    [
      "QRZ",
      "Who is calling me?",
      "You are being called by ...",
      "Use after a call you need to identify; not as a clear-frequency check."
    ],
    [
      "QSA",
      "What is the strength of my signal?",
      "Strength is ... on the formal 1-5 scale.",
      "Not the S1-S9 scale in RST."
    ],
    [
      "QSB",
      "Are my signals fading?",
      "Your signals are fading.",
      "UR SIGS QSB"
    ],
    [
      "QSD",
      "Are my signals mutilated?",
      "Your signals are mutilated.",
      "In CW conversation it often refers to defective keying; ask tactfully."
    ],
    [
      "QSK",
      "Can you hear between your signals, and may I break in?",
      "I can hear between my signals; you may break in.",
      "Full break-in depends on the station’s capabilities and settings."
    ],
    [
      "QSL",
      "Can you acknowledge receipt?",
      "I acknowledge receipt.",
      "A spoken or keyed QSL does not itself create an electronic award confirmation."
    ],
    [
      "QSN",
      "Did you hear me or the named station on that frequency?",
      "I heard the specified station there.",
      "HRD U ON 20M is a plain alternative."
    ],
    [
      "QSO",
      "Can you communicate with the named station?",
      "I can communicate with that station.",
      "As a noun, QSO simply means a radio contact."
    ],
    [
      "QSP",
      "Will you relay a message?",
      "I will relay it.",
      "Identify the recipient and the message."
    ],
    [
      "QSU",
      "Shall I send or reply on the stated frequency?",
      "Send or reply on that frequency.",
      "QSY is more familiar for an ordinary change of frequency."
    ],
    [
      "QSV",
      "Shall I send a series of Vs?",
      "Send a series of Vs.",
      "A test request; avoid creating interference."
    ],
    [
      "QSX",
      "Will you listen to the named station on that frequency?",
      "I am listening to that station on that frequency.",
      "QSX followed by a frequency commonly announces where a station is listening."
    ],
    [
      "QSY",
      "Shall I change transmission to another frequency?",
      "Change transmission to another frequency.",
      "PSE QSY 14060; first make sure the new spot is usable."
    ],
    [
      "QSZ",
      "Shall I send each word or group more than once?",
      "Send each word or group the specified number of times.",
      "PSE QSZ 2"
    ],
    [
      "QTC",
      "How many messages have you to send?",
      "I have ... messages.",
      "Some contests have a special QTC exchange; learn its rules first."
    ],
    [
      "QTH",
      "What is your position?",
      "My position or location is ...",
      "QTH RIVERDALE is normal conversational ham usage."
    ],
    [
      "QTR",
      "What is the correct time?",
      "The correct time is ...",
      "State UTC unless another basis is explicit."
    ],
    [
      "QTU",
      "What are your operating hours?",
      "I operate between the stated hours.",
      "An agreed operating schedule."
    ],
    [
      "QUA",
      "Have you news of the named station?",
      "I have news of that station.",
      "A less common code; full words may be easier."
    ]
  ],
